<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/generate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="100dp"
        android:paddingBottom="20dp"
        android:text="Losuj" />

    <TextView
        android:id="@+id/text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="24dp"
        android:text="Slowko" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEnglish"
            android:layout_width="wrap_content"
            android:width="150dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="#87B9E9"

            android:text="Angielski" />

        <Button
            android:id="@+id/btnSpanish"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:width="150dp"

            android:backgroundTint="#E92020"

            android:layout_weight="1"
            android:text="Hiszpanski" />

        <Button
            android:id="@+id/btnDeuth"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:width="150dp"

            android:backgroundTint="#BEED71"

            android:layout_weight="1"
            android:text="Niemiecki" />

        <Button
            android:id="@+id/btnPolski"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:width="150dp"

            android:layout_weight="1"
            android:backgroundTint="#5E68EF"
            android:text="Polski" />
    </LinearLayout>

</LinearLayout>